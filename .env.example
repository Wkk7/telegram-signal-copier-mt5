# Copy this file to .env and edit the values

# From @BotFather
TELEGRAM_TOKEN=
# Your signal channel (the bot must be an admin there)
SOURCE_CHAT_ID=-1001234567890
# Your private chat with the bot: receipts and /status /pause /resume
ADMIN_CHAT_ID=123456789

# % of balance risked per signal
RISK_PCT=0.5
MAX_OPEN_TRADES=5
# true = one order per TP, false = a single order with TP1
SPLIT_TPS=true

# Broker naming, e.g. SYMBOL_SUFFIX=.pro  or  SYMBOL_MAP=XAUUSD=GOLD,US30=DJ30
SYMBOL_SUFFIX=
SYMBOL_MAP=

MAGIC=880088
# true = only report what would be copied. Test on a DEMO account before setting false!
DRY_RUN=true
